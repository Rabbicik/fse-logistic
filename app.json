{
  "expo": {
    "name": "FSE Logistic",
    "slug": "fse-logistic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./fse.png",
    "scheme": "fselogistic",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "FSE Logistic potrzebuje dostępu do aparatu, aby skanować listy zaopatrzenia."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./fse.png",
        "backgroundColor": "#0D0D1F"
      },
      "package": "com.rabbicik.fselogistic",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./fse.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FSE Logistic potrzebuje dostępu do aparatu, aby skanować listy zaopatrzenia.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0D1F",
          "image": "./fse.png",
          "imageWidth": 120
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermissionText": "FSE Logistic potrzebuje dostępu do aparatu, aby skanować listy zaopatrzenia."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6d5ea608-5901-46d7-bfa3-ea44853b0d3d"
      }
    }
  }
}
